<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarDetail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/background_main"
            app:titleTextColor="@color/text_primary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textDetailFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

        <ImageView
            android:id="@+id/imageDetail"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:background="@color/background_surface_2"
            android:contentDescription="@string/detail_image_description" />

        <!-- Probabilita' -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_forensic_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_section_probabilities"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:id="@+id/containerProbabilities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp" />

        </LinearLayout>

        <!-- Nota -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_forensic_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_section_note"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.08" />

            <EditText
                android:id="@+id/editDetailNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_history_item"
                android:padding="12dp"
                android:hint="@string/detail_note_hint"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_disabled"
                android:inputType="textMultiLine"
                android:minLines="2" />

            <Button
                android:id="@+id/buttonSaveNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/primary"
                android:textColor="@color/text_primary"
                android:text="@string/detail_note_save" />

            <TextView
                android:id="@+id/textNoteSaved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/detail_note_saved_confirmation"
                android:textColor="@color/status_success"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>