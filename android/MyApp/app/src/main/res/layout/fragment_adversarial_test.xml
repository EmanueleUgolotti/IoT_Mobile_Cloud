<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imageAdvPreview"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop"
            android:contentDescription="@string/adv_image_preview_description" />

        <Button
            android:id="@+id/buttonAdvPickImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/adv_pick_image" />

        <Button
            android:id="@+id/buttonAdvPickFromHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/adv_pick_from_history" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#DDDDDD" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/adv_section_attack"
            android:textStyle="bold"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/radioGroupAttack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/radioAttackBoundary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/adv_attack_boundary" />

            <RadioButton
                android:id="@+id/radioAttackSimba"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adv_attack_simba" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/adv_max_iter_label"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/editMaxIter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="@string/adv_max_iter_hint" />

        <Button
            android:id="@+id/buttonRunAttack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/adv_run_attack" />

        <LinearLayout
            android:id="@+id/layoutAdvProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/adv_running" />

        </LinearLayout>

        <TextView
            android:id="@+id/textAdvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#C62828"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#DDDDDD" />

        <LinearLayout
            android:id="@+id/layoutAdvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adv_section_result"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textAdvOutcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/adv_original_label"
                        android:textSize="12sp" />

                    <ImageView
                        android:id="@+id/imageAdvOriginal"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_marginTop="4dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/adv_original_label" />

                    <TextView
                        android:id="@+id/textAdvOriginalLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/adv_adversarial_label" />

                    <ImageView
                        android:id="@+id/imageAdvPerturbed"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_marginTop="4dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/adv_adversarial_label" />

                    <TextView
                        android:id="@+id/textAdvAdversarialLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/adv_section_probabilities_original"
                android:textStyle="bold"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/containerProbsOriginal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/adv_section_probabilities_adversarial"
                android:textStyle="bold"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/containerProbsAdversarial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>